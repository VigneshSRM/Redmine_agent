# Redmine Agent — connection settings
# Copy this file to `.env` and fill in your values.
# `.env` is gitignored — NEVER commit real keys.
#
# Where to find the values:
#   REDMINE_URL       = the address you open Redmine with, e.g. https://redmine.mycompany.com
#   REDMINE_API_KEY   = Redmine → click your name (top right) → My account
#                       → right-hand pane "API access key" → Show/Copy
#                       (If it is missing: Administration → Settings → API →
#                        check "Enable REST API" first.)
#   REDMINE_ADMIN_KEY = optional; admin API key, only needed for impersonation
#                       (X-Redmine-Switch-User header)

REDMINE_URL=https://redmine.example.com
REDMINE_API_KEY=paste-your-api-key-here

# optional
# REDMINE_ADMIN_KEY=
# REDMINE_AGENT_NAME=Redmine Agent
